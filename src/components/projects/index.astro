---
import styles from "./index.module.scss";
import { useTranslations, type Lang } from "@/i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = [
    { label: "zakielpc.com", href: "https://zakielpc.com", desc: t("projects.zakielpc.desc") },
    { label: "zar.mx", href: "https://zar.mx", desc: t("projects.zarmx.desc") },
    { label: "diego.zar.mx", href: "https://diego.zar.mx", desc: t("projects.diego.desc") },
];
---

<section id="projects" class={styles.projects}>
    <h2>{t("projects.title")}</h2>

    <div class={styles.list}>
        {
            projects.map((project) => (
                <a href={project.href} target="_blank" rel="noopener noreferrer">
                    <span class={styles.label}>{project.label}</span>
                    <span class={styles.desc}>{project.desc}</span>
                    <span class={styles.icon}>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            width="16"
                            height="16"
                        >
                            <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                            <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
                        </svg>
                    </span>
                </a>
            ))
        }
    </div>
</section>
