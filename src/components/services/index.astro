---
import styles from "./index.module.scss";
import { useTranslations, type Lang } from "@/i18n/ui";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
    { title: t("services.web.title"), desc: t("services.web.desc") },
    { title: t("services.apps.title"), desc: t("services.apps.desc") },
    { title: t("services.seo.title"), desc: t("services.seo.desc") },
    { title: t("services.support.title"), desc: t("services.support.desc") },
];
---

<section id="services" class={styles.services}>
    <h2>{t("services.title")}</h2>

    <div class={styles.grid}>
        {
            services.map((service, i) => (
                <article class={styles.card}>
                    <span class={styles.index}>0{i + 1}</span>
                    <h3>{service.title}</h3>
                    <p>{service.desc}</p>
                </article>
            ))
        }
    </div>
</section>
